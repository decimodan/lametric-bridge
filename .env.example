# Clock LAN IP (mDNS .local does not resolve inside Docker/Dokploy)
AWTRIX_BASE_URL=http://192.168.50.98

# Optional HTTP Basic if you enable auth on the device
AWTRIX_USER=
AWTRIX_PASS=

# Bind all interfaces in Docker; Traefik reaches the container on 8787
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8787

# Optional. If set, API callers must send:
#   Authorization: Bearer <token>
#   or X-Bridge-Token: <token>
BRIDGE_TOKEN=
